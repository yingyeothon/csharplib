<!--
  IL2CPP managed stripping removes types it cannot see being used. These
  assemblies are reached through interfaces and factories, so preserve them
  wholesale rather than chasing individual entry points.
-->
<linker>
  <assembly fullname="Yingyeothon.Codec" preserve="all" />
  <assembly fullname="Yingyeothon.Logger" preserve="all" />
  <assembly fullname="Yingyeothon.Assets" preserve="all" />
</linker>
