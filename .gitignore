artifacts/
bin/
obj/
.vs/
.idea/
.vscode/
*.user
*.suo
.claude/
TestResults/

# The public-API gate writes the actual surface next to the approved snapshot when
# they differ, and the API-reference gate does the same for docs/api/*.md. Approving
# either is a rename, so a received file is never committed.
*.received.txt
*.received.md

# Unity generates a .meta for everything it imports. The ones under packages/ are
# committed: a package installed by git URL is immutable, and Unity ignores every asset
# in it that has no .meta (rules/unity.md; scripts/unity-meta.sh makes and checks them).
# Anywhere else a .meta means a Unity project was opened inside the repo, and the hooks
# refuse it, because .gitignore does not survive `git add -f`.
*.meta
!/packages/**/*.meta
/packages/**/*~/**/*.meta
/packages/**/.*/**/*.meta

# A Unity project opened anywhere under the repo would otherwise offer these up.
Library/
Logs/
Temp/
UserSettings/
Builds/

# Defense in depth for a public repo: this repository has no infrastructure and needs
# no credentials, so any file of these shapes is a mistake, not a configuration.
.env
.env.*
!.env.example
.envrc
local/
