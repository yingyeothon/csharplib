#!/usr/bin/env bash
# Defense in depth for a PUBLIC repo (rules/security.md):
#  1. refuse paths that must never be tracked, even when force-added past .gitignore;
#  2. gitleaks on the staged diff.
#
# Two traps this hook is written around, both learned the hard way in the sibling
# `service` repo — do not "simplify" them back:
#  * Never `grep -q`. It exits at the first match, which SIGPIPEs the upstream command,
#    and under `set -o pipefail` that 141 makes the test false — so the guard passes
#    silently on exactly the large diffs it exists to catch. Capture and count instead.
#  * Every grep runs with `-a`. One NUL byte anywhere in the stream makes grep call the
#    rest binary and stop matching, and half a history went unscanned that way.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# -z, never the default output: git quotes a name with a non-ASCII, control, '"' or '\'
# character ("\354\234\240.../a.meta"), and a quoted line matches none of the anchored
# patterns below. A name with a newline in it would split into two lines, so it is
# refused outright.
if [ "$(git diff --cached --name-only -z --diff-filter=ACMRT | tr -cd '\n' | wc -c)" -ne 0 ]; then
  echo "pre-commit: a staged path contains a newline; rename it" >&2
  exit 1
fi
staged=$(git diff --cached --name-only -z --diff-filter=ACMRT | tr '\0' '\n')

# .meta: allowed only below a package root, and never under a name Unity hides (one
#        starting with '.' or ending in '~'). Anywhere else it is a Unity project
#        opened inside the repo. Whether each one belongs to an asset, and is well
#        formed, is scripts/unity-meta.sh's call, run on the index below.
# artifacts|bin|obj|Library|Temp|Logs: build output. A bin/ or obj/ inside a package
#        folder becomes Unity project assets (scripts/validate-packages.sh).
# .received.*: the public-API and API-reference gates' actual output; approving is
#        a rename, so a received file is never committed.
# .env*/.envrc/local/: this repo needs no credentials, so one of these is a mistake.
bad=$({ printf '%s\n' "$staged" | grep -a -E \
  '\.received\.[a-z]+$|(^|/)(artifacts|bin|obj|Library|Temp|Logs|UserSettings|Builds)/|(^|/)\.env(\.|$)|(^|/)\.envrc$|^local/' \
  | grep -a -vE '\.env\.example$'
  printf '%s\n' "$staged" | grep -a -E '\.meta$' | grep -a -vE '^packages/[^/]+/(([^./~]|[^./][^/]*[^/~])/)*([^./~]|[^./][^/]*[^/~])\.meta$'; } || true)
if [ -n "$bad" ]; then
  echo "pre-commit: refusing paths that must never be tracked:" >&2
  printf '%s\n' "$bad" >&2
  exit 1
fi

# The index, not the working tree: a .meta that --write created but nobody staged
# would otherwise pass every local check and land an asset Unity ignores.
# Any change under packages/ — an add, a rename, a deletion, a file turned symlink.
if ! git diff --cached --quiet -- packages/; then
  ./scripts/unity-meta.sh --staged >/dev/null || {
    echo "pre-commit: a staged package asset and its .meta disagree; see above" >&2
    exit 1
  }
fi

command -v gitleaks >/dev/null || {
  echo "pre-commit: gitleaks is required (apt install gitleaks / brew install gitleaks)" >&2
  echo "pre-commit: install it, or run scripts/install-git-hooks.sh again after installing" >&2
  exit 1
}
gitleaks protect --staged --redact --no-banner --config .gitleaks.toml
